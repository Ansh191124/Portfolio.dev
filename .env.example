# Public site config (all optional — UI hides anything that is not configured)
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_RESUME_URL=
# Set to "true" only if you are actually open to new projects
NEXT_PUBLIC_AVAILABLE=false

# GitHub activity (server-side). Username enables repos/languages/activity.
# A token (read:user) additionally enables the real contribution graph.
GITHUB_USERNAME=
GITHUB_TOKEN=
